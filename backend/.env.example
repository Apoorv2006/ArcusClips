# ArcusClips — backend configuration (copy to backend/.env and edit).
# Every setting is prefixed with ARCUS_ and can also be supplied as a real
# environment variable. All AI processing runs locally; nothing is sent to
# external AI APIs.

# ---------- Application ----------
ARCUS_APP_NAME=ArcusClips
ARCUS_ENVIRONMENT=development
# Random string used to sign/encrypt credentials — CHANGE THIS in production.
ARCUS_SECRET_KEY=change-me-in-production-local-dev-key
ARCUS_HOST=127.0.0.1
ARCUS_PORT=8000

# ---------- Database ----------
# Empty => SQLite file at <data_dir>/arcusclips.db (default, zero-config).
# Postgres example (optional):
#   ARCUS_DATABASE_URL=postgresql+psycopg://arcus:arcus@127.0.0.1:5432/arcusclips
ARCUS_DATABASE_URL=

# ---------- Storage ----------
# Defaults to <repo>/data. All media, transcripts, renders and exports live here.
ARCUS_DATA_DIR=
# Storage quota in bytes (default 200 GB).
ARCUS_MAX_STORAGE_BYTES=214748364800

# ---------- Render defaults ----------
ARCUS_RENDER_WIDTH=1080
ARCUS_RENDER_HEIGHT=1920
ARCUS_RENDER_FPS=30
ARCUS_RENDER_CRF=20
ARCUS_RENDER_PRESET=medium

# ---------- FFmpeg ----------
# Leave empty to auto-detect the bundled imageio-ffmpeg binary, then PATH.
# Override only if you want a specific ffmpeg/ffprobe (e.g. a GPU build).
ARCUS_FFMPEG_PATH=
ARCUS_FFPROBE_PATH=

# ---------- Whisper (local transcription, faster-whisper) ----------
# tiny | base | small | medium | large-v2 | large-v3
ARCUS_WHISPER_MODEL=base
# Optional local model directory / HF cache override.
ARCUS_WHISPER_MODEL_DIR=
# auto | cpu | cuda
ARCUS_WHISPER_DEVICE=auto
# auto | int8 | int8_float16 | float16 | float32
ARCUS_WHISPER_COMPUTE_TYPE=auto
# Empty = auto-detect language.
ARCUS_WHISPER_LANGUAGE=

# ---------- LM Studio (local OpenAI-compatible LLM — the ONLY LLM used) ----------
ARCUS_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Empty = auto-detect the first available model from /v1/models.
ARCUS_LMSTUDIO_MODEL=
ARCUS_LMSTUDIO_API_KEY=
ARCUS_LMSTUDIO_MAX_TOKENS=2048
ARCUS_LMSTUDIO_TEMPERATURE=0.4
ARCUS_LMSTUDIO_MAX_CONTEXT_TOKENS=8192
# When LM Studio is unreachable, fall back to deterministic local heuristics
# (outputs are flagged with is_heuristic=true).
ARCUS_ALLOW_HEURISTIC_FALLBACK=true

# ---------- Processing resources ----------
ARCUS_MAX_PROCESSING_CONCURRENCY=2
ARCUS_MAX_RENDER_CONCURRENCY=2
ARCUS_MAX_DOWNLOAD_CONCURRENCY=2
ARCUS_JOB_POLL_INTERVAL=1.0
# Seconds without a heartbeat before a crashed worker job is requeued.
ARCUS_JOB_STALE_TIMEOUT=1800

# ---------- Google Drive OAuth (read-only) ----------
# Get these from Google Cloud Console. OAuth consent screen + credential.
# Redirect URI must match ARCUS_GOOGLE_OAUTH_REDIRECT_URI exactly.
ARCUS_GOOGLE_OAUTH_CLIENT_ID=
ARCUS_GOOGLE_OAUTH_CLIENT_SECRET=
ARCUS_GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
ARCUS_GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.readonly
# Fernet key for encrypting stored access/refresh tokens.
# Empty => a key is generated once and stored at <data_dir>/oauth_credential.key.
ARCUS_OAUTH_CREDENTIAL_ENCRYPTION_KEY=

# ---------- Source scanning ----------
# Comma-separated domain allowlist for public-webpage crawling.
# Empty = no domain restriction (still blocked from private/loopback addresses).
ARCUS_ALLOWED_SOURCE_DOMAINS=
ARCUS_CRAWL_MAX_DEPTH=2
ARCUS_CRAWL_MAX_PAGES=25
ARCUS_CRAWL_RATE_LIMIT_DELAY=0.5
ARCUS_MAX_DOWNLOAD_SIZE=4294967296
ARCUS_SUPPORTED_VIDEO_FORMATS=mp4,mov,mkv,webm,m4v,avi,mpeg,mpg,ts

# ---------- Auth ----------
ARCUS_AUTH_ENABLED=true
ARCUS_DEFAULT_ADMIN_USERNAME=admin
# CHANGE the default admin password before exposing the app.
ARCUS_DEFAULT_ADMIN_PASSWORD=changeme
ARCUS_SESSION_TTL_HOURS=72

# ---------- Rate limiting ----------
ARCUS_RATE_LIMIT_REQUESTS_PER_MINUTE=600
